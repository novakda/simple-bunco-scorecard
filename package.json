{
  "name": "simple-bunco-scorecard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tailnet": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "sync": "npm run build && node scripts/sync.js",
    "golden": "node scripts/generate-golden.js --find --out telemetry/golden-game.json",
    "collect": "node scripts/telemetry-collector.js",
    "replay": "node scripts/telemetry-collector.js --replay",
    "serve:app": "node harness-guide/appserve.cjs dist",
    "serve:guide": "node harness-guide/listserve.cjs",
    "tunnel": "node scripts/tunnel.js"
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
